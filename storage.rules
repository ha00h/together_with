rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /rooms/{roomId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == firestore.get(/databases/(default)/documents/rooms/$(roomId)).data.hostUid;
    }
  }
}
