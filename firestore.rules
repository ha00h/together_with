rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /rooms/{roomId} {
      allow get: if request.auth != null
        && (resource == null
          || !('expiresAt' in resource.data)
          || request.time < resource.data.expiresAt
          || resource.data.hostUid == request.auth.uid);
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.storagePath is string
        && request.resource.data.fileName is string
        && request.resource.data.kind in ['pdf', 'image']
        && request.resource.data.version is int
        && request.resource.data.pageCount is int
        && request.resource.data.createdAt == request.time;
      allow update: if request.auth != null
        && resource.data.hostUid == request.auth.uid
        && request.resource.data.hostUid == resource.data.hostUid;
      allow delete: if request.auth != null
        && resource.data.hostUid == request.auth.uid;
    }
  }
}
